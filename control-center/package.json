{
  "name": "home-tunnel-control-center",
  "version": "2.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "preview": "node scripts/preview.mjs",
    "preview:ui": "node scripts/ui-preview.mjs",
    "start": "node dist/server.js",
    "test": "node --test dist/security.test.js",
    "test:public": "node --test dist/public.test.js",
    "test:integration": "node scripts/run-integration.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "hash-wasm": "4.12.0",
    "pg": "8.22.0",
    "ws": "8.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
