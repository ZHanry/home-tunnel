{
  "name": "home-tunnel-control-center",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "preview": "node scripts/preview.mjs",
    "preview:ui": "node scripts/ui-preview.mjs",
    "start": "node dist/server.js",
    "test": "node --test dist/security.test.js dist/db.test.js dist/backup.test.js dist/public.test.js && node scripts/run-integration.mjs",
    "test:public": "node --test dist/public.test.js",
    "test:integration": "node scripts/run-integration.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "hash-wasm": "4.12.0",
    "ws": "8.18.3",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.17.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
