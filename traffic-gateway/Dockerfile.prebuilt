ARG NODE_IMAGE=node:24.19.0-alpine
FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -g 10001 -S home-tunnel \
    && adduser -u 10001 -S -D -H -G home-tunnel home-tunnel
COPY --chown=10001:10001 package.json ./package.json
COPY --chown=10001:10001 dist ./dist
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["node", "dist/server.js"]
