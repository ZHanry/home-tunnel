<Window x:Class="HomeTunnel.Client.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接设置 - Home Tunnel" Width="540" MinWidth="520" MaxHeight="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource PageBrush}"
        Closing="Window_Closing" KeyDown="Window_KeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="{DynamicResource PageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="20,13">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="DialogTitleText" Text="新建连接"
                     Foreground="{DynamicResource InkBrush}" FontSize="18" FontWeight="Bold" />
          <TextBlock x:Name="DialogSubtitleText" Text="映射本地服务至公网，生成专属访问地址"
                     Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
        <Border x:Name="HeaderIconBorder" Grid.Column="1" Width="38" Height="38"
                Background="{DynamicResource PrimarySoftBrush}"
                BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10">
          <Viewbox Margin="9">
            <Path x:Name="HeaderIconPath" Data="{StaticResource IconPlus}"
                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Viewbox>
        </Border>
      </Grid>
    </Border>

    <ProgressBar Grid.Row="1" x:Name="TopProgressBar" Height="2" IsIndeterminate="True"
                 Foreground="{DynamicResource PrimaryBrush}" Background="Transparent"
                 BorderThickness="0" Visibility="Hidden" />

    <StackPanel Grid.Row="2" x:Name="FormPanel" Margin="20,13,20,14">
      <TextBlock Text="公网入口" Foreground="{DynamicResource InkBrush}"
                 FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9" />

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="84" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Content="连接名称" Target="{Binding ElementName=ConnectionNameBox}"
               VerticalAlignment="Center" Padding="0" />
        <TextBox Grid.Column="1" x:Name="ConnectionNameBox" MaxLength="128"
                 AutomationProperties.Name="连接名称"
                 AutomationProperties.HelpText="用于在客户端列表中标识这条连接" />
      </Grid>

      <Grid Margin="0,0,0,13">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="84" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Content="公网子域" Target="{Binding ElementName=SubdomainBox}"
               VerticalAlignment="Top" Padding="0" Margin="0,9,0,0" />
        <StackPanel Grid.Column="1">
          <TextBox x:Name="SubdomainBox" MaxLength="63"
                   AutomationProperties.Name="公网子域"
                   AutomationProperties.HelpText="只能包含小写字母、数字和连字符" />
          <Border Margin="0,6,0,0" Background="{DynamicResource PrimarySoftBrush}"
                  BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="10,6" MinHeight="32">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                <Path Data="{StaticResource IconGlobe}" Stroke="{DynamicResource PrimaryBrush}"
                      StrokeThickness="1.7" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Viewbox>
              <TextBlock Grid.Column="1" x:Name="PublicAddressHint" Margin="8,0,0,0"
                         Text="https://&lt;子域&gt;.tunnel.example.com"
                         Foreground="{DynamicResource PrimaryHoverBrush}" FontSize="12"
                         FontFamily="Cascadia Mono, Consolas, monospace"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

      <TextBlock Text="本地服务目标" Foreground="{DynamicResource InkBrush}"
                 FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9" />
      <Grid Margin="0,0,0,11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="84" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Content="目标地址" Target="{Binding ElementName=LocalHostBox}"
               VerticalAlignment="Center" Padding="0" />
        <ComboBox Grid.Column="1" x:Name="SchemeBox" SelectedIndex="0"
                  AutomationProperties.Name="本地协议">
          <ComboBoxItem Content="http" />
          <ComboBoxItem Content="https" />
        </ComboBox>
        <TextBox Grid.Column="3" x:Name="LocalHostBox" Text="127.0.0.1" MaxLength="255"
                 AutomationProperties.Name="本地主机"
                 ToolTip="本地主机，例如 127.0.0.1" />
        <TextBox Grid.Column="5" x:Name="LocalPortBox" MaxLength="5"
                 AutomationProperties.Name="本地端口"
                 ToolTip="端口范围 1–65535" />
      </Grid>

      <CheckBox x:Name="EnabledBox" Content="创建后立即启用公网访问" IsChecked="True"
                Margin="84,0,0,0" VerticalAlignment="Center" />

      <Border x:Name="ErrorBanner" Visibility="Collapsed" Margin="0,11,0,0"
              Background="{DynamicResource DangerSoftBrush}"
              BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="10,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Viewbox Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0">
            <Path Data="{StaticResource IconAlert}" Stroke="{DynamicResource DangerBrush}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Viewbox>
          <TextBlock Grid.Column="1" x:Name="DialogError" Text="" Margin="8,0,0,0"
                     Foreground="{DynamicResource DangerBrush}" FontSize="12" LineHeight="17"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        </Grid>
      </Border>
    </StackPanel>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="20,10">
      <Grid>
        <Button x:Name="DeleteButton" Content="删除连接"
                Style="{StaticResource TertiaryButtonStyle}"
                Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left"
                MinWidth="96" Height="36" MinHeight="36" Padding="10,0"
                Click="DeleteButton_Click" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="BusyText" Text="正在处理…" Foreground="{DynamicResource MutedBrush}"
                     FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                     Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="CancelButton" Content="取消"
                  Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                  MinWidth="80" Height="36" MinHeight="36" IsCancel="True"
                  Click="CancelButton_Click" />
          <Button x:Name="SaveButton" Content="保存连接" MinWidth="100"
                  Height="36" MinHeight="36" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
