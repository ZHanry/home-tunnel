<Window x:Class="HomeTunnel.Client.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home Tunnel 更新" Width="540" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="28,26,28,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="StatusIconBorder" Width="44" Height="44" CornerRadius="11"
                Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                BorderThickness="1" VerticalAlignment="Top">
          <Viewbox Margin="10">
            <Path x:Name="StatusIconPath" Data="{StaticResource IconDownload}"
                  Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.75"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Fill="Transparent" />
          </Viewbox>
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="EyebrowText" Text="新版本可用" Foreground="{DynamicResource PrimaryBrush}"
                     FontSize="11" FontWeight="SemiBold" />
          <TextBlock x:Name="TitleText" Text="Home Tunnel 有新版本"
                     Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="SemiBold"
                     Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                 Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite" />

      <Border x:Name="VersionPanel" Background="{DynamicResource SurfaceMutedBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9"
              Padding="15,12" Margin="0,17,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="当前版本" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource TextBrush}"
                       FontWeight="SemiBold" FontSize="16" Margin="0,3,0,0" />
          </StackPanel>
          <Viewbox Grid.Column="1" Width="17" Height="17" VerticalAlignment="Center">
            <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource MutedBrush}"
                  StrokeThickness="1.75" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Viewbox>
          <StackPanel Grid.Column="2">
            <TextBlock Text="可用版本" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock x:Name="LatestVersionText" Foreground="{DynamicResource PrimaryBrush}"
                       FontWeight="SemiBold" FontSize="16" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="DetailsPanel" Background="{DynamicResource PrimarySoftBrush}"
              BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="9"
              Padding="13,11" Margin="0,11,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Viewbox Width="17" Height="17" VerticalAlignment="Top" Margin="0,1,0,0">
            <Path Data="{StaticResource IconDocument}" Stroke="{DynamicResource PrimaryBrush}"
                  StrokeThickness="1.75" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
          </Viewbox>
          <TextBlock x:Name="DetailsText" Grid.Column="1" Foreground="{DynamicResource PrimaryHoverBrush}"
                     FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="8,0,0,0" />
        </Grid>
      </Border>

      <StackPanel x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
        <Grid Margin="1,0,1,7">
          <TextBlock Text="后台下载进度" Style="{StaticResource CaptionTextStyle}" />
          <TextBlock x:Name="DownloadProgressText" Text="0%"
                     Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                     HorizontalAlignment="Right" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <ProgressBar x:Name="DownloadProgressBar" Height="5" Minimum="0" Maximum="100"
                     Foreground="{DynamicResource PrimaryBrush}"
                     Background="{DynamicResource PrimaryBorderBrush}" />
      </StackPanel>

      <TextBlock x:Name="InlineError" Text="" Style="{StaticResource ErrorTextStyle}"
                 Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="20,13">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelActionButton" Content="稍后"
                Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                Margin="0,0,8,0" Click="CancelActionButton_Click" />
        <Button x:Name="PrimaryActionButton" Content="立即下载" MinWidth="128"
                IsDefault="True" Click="PrimaryActionButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
