<Window x:Class="HomeTunnel.Client.BrandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home Tunnel" Width="404" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,24,24,22">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="IconBorder" Width="44" Height="44" CornerRadius="12"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1"
                VerticalAlignment="Top">
          <Viewbox Margin="10">
            <Path x:Name="IconPath" Data="{StaticResource IconShield}"
                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Fill="Transparent" />
          </Viewbox>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Foreground="{StaticResource InkBrush}"
                     FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="EyebrowText" Foreground="{StaticResource MutedBrush}"
                     FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="MessageText" Style="{StaticResource BodyTextStyle}"
                 TextWrapping="Wrap" Margin="0,18,0,0" />

      <Border x:Name="DetailsPanel" Visibility="Collapsed"
              Background="{StaticResource SurfaceMutedBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
        <TextBlock x:Name="DetailsText" Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12" LineHeight="19" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click" />
        <Button x:Name="PrimaryButton" Content="确定" MinWidth="104"
                IsDefault="True" Click="PrimaryButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
