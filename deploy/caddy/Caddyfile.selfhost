{
    email {$HOME_TUNNEL_ACME_EMAIL}
    on_demand_tls {
        ask http://control-center:8080/internal/tls/allow
    }
}

# The console host is statically known, so it uses regular ACME issuance at
# startup instead of on-demand TLS; this keeps console certificate issuance
# independent of control-center availability.
{$HOME_TUNNEL_CONSOLE_HOST} {
    encode zstd gzip
    reverse_proxy control-center:8080
}

*.{$HOME_TUNNEL_TUNNEL_DOMAIN} {
    tls {
        on_demand
    }
    reverse_proxy traffic-gateway:8080
}

# 自定义域名无法由静态通配符覆盖；控制中心的 ask 端点只对已验证、当前可用
# 的域名授权证书，流量仍交给同一网关复用门禁、限速与配额。
https:// {
    tls {
        on_demand
    }
    reverse_proxy traffic-gateway:8080
}
